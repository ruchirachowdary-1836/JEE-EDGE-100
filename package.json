{
  "name": "jee-edge-100",
  "version": "1.0.0",
  "private": true,
  "description": "JEE EDGE 100 - structured JEE Main 2027 preparation platform",
  "scripts": {
    "db:local": "node scripts/local-postgres.mjs",
    "dev": "next dev -p 3100",
    "build": "prisma generate && next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "student:reset": "tsx scripts/reset-student.ts",
    "postinstall": "prisma generate",
    "pages:build": "cd pages-site && next build",
    "test:unit": "tsx --conditions=react-server --test tests/unit.test.ts",
    "test:e2e": "tsx tests/e2e.ts",
    "test:crawl": "tsx tests/crawl.ts",
    "check:content": "tsx scripts/check-notes.ts && tsx scripts/check-questions.ts && tsx scripts/audit-formulas.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "framer-motion": "^11.11.9",
    "katex": "^0.16.11",
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0",
    "server-only": "^0.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/katex": "^0.16.7",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "embedded-postgres": "^18.6.0-beta.19",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.23.1": true,
    "prisma@5.22.0": true
  }
}
